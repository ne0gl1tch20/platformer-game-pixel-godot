[application]
config/name="Platformer Game Pixel"
run/main_scene="res://scenes/game/Game.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[display]
window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[autoload]
SaveSystem="*res://scripts/core/SaveSystem.cs"
AndroidBridge="*res://scripts/platform/AndroidBridge.cs"

[dotnet]
project/assembly_name="Platformer Game Pixel"

[physics]
3d/physics_engine="Jolt Physics"

[rendering]
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=0
